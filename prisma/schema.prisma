generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Application {
  id String @id @default(uuid())
  company String
  role String 
  status JobStatus
  appliedAt DateTime
  notes String?
  link String?
}

enum JobStatus {
  Applied
  Interview
  Rejected 
  Offer
}