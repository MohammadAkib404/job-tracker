generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Application {
  id String @id @default(uuid())
  company String
  position String 
  status JobStatus
  appliedAt DateTime
  salary Int
  contact String
  notes String
}

enum JobStatus {
  Applied
  Interview
  Rejected 
  Offer
}